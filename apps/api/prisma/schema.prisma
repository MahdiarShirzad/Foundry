generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// Auth
// ─────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions               Session[]
  workspaceMembers       WorkspaceMember[]
  emailVerificationCodes EmailVerificationCode[]
  passwordResetTokens    PasswordResetToken[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────
// Workspace
// ─────────────────────────────────────────

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  products    Product[]
  ideas       Idea[]
  marketIdeas MarketIdea[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────
// Product
// ─────────────────────────────────────────

model Product {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ideas     Idea[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

// ─────────────────────────────────────────
// Stage 01 — Idea Lab
// ─────────────────────────────────────────

model Idea {
  id            String     @id @default(cuid())
  workspaceId   String
  productId     String
  ref           String
  name          String
  headline      String?
  summary       String?
  problem       String?
  audience      String?
  category      String?
  tags          String[]
  status        IdeaStatus @default(INBOX)
  source        String?
  context       String?
  openQuestions String[]
  capturedAt    DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace   Workspace      @relation(fields: [workspaceId], references: [id])
  product     Product        @relation(fields: [productId], references: [id])
  notes       IdeaNote[]
  marketIdea  MarketIdea?
  hypotheses  Hypothesis[]
  experiments Experiment[]
  evidence    EvidenceItem[]
}

model IdeaNote {
  id       String   @id @default(cuid())
  ideaId   String
  author   String
  initials String
  date     DateTime @default(now())
  body     String

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}

enum IdeaStatus {
  INBOX
  EXPLORING
  SHORTLISTED
}

// ─────────────────────────────────────────
// Stage 02 — Market Intelligence
// ─────────────────────────────────────────

model MarketIdea {
  id          String   @id @default(uuid())
  ideaId      String   @unique
  workspaceId String
  summary     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  idea          Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  competitors   Competitor[]
  segments      Segment[]
  opportunities Opportunity[]
  notes         ResearchNote[]

  @@index([workspaceId])
}

model Competitor {
  id             String   @id @default(uuid())
  marketIdeaId   String
  name           String
  website        String?
  description    String?
  strengths      String[]
  weaknesses     String[]
  pricing        String?
  targetAudience String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  marketIdea MarketIdea @relation(fields: [marketIdeaId], references: [id], onDelete: Cascade)

  @@index([marketIdeaId])
}

model Segment {
  id           String   @id @default(uuid())
  marketIdeaId String
  name         String
  description  String
  size         String?
  painPoints   String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  marketIdea    MarketIdea    @relation(fields: [marketIdeaId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([marketIdeaId])
}

model Opportunity {
  id           String   @id @default(uuid())
  marketIdeaId String
  segmentId    String?
  title        String
  description  String
  significance String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  marketIdea MarketIdea @relation(fields: [marketIdeaId], references: [id], onDelete: Cascade)
  segment    Segment?   @relation(fields: [segmentId], references: [id])

  @@index([marketIdeaId])
}

model ResearchNote {
  id           String   @id @default(uuid())
  marketIdeaId String
  relatedType  String
  relatedId    String
  body         String
  author       String?
  createdAt    DateTime @default(now())

  marketIdea MarketIdea @relation(fields: [marketIdeaId], references: [id], onDelete: Cascade)

  @@index([marketIdeaId])
  @@index([relatedType, relatedId])
}

// ─────────────────────────────────────────
// Stage 03 — Validation Lab
// ─────────────────────────────────────────

model Hypothesis {
  id                   String              @id @default(uuid())
  ideaId               String
  title                String
  statement            String
  customerSegment      String?
  category             HypothesisCategory?
  rationale            String?
  importance           Importance          @default(MEDIUM)
  status               HypothesisStatus    @default(DRAFT)
  relatedExperimentIds String[]
  linkedFindings       String[]
  unresolvedQuestions  String[]
  isDraft              Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  idea        Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  experiments Experiment[]
  evidence    EvidenceItem[]

  @@index([ideaId])
}

model Experiment {
  id                  String            @id @default(uuid())
  ideaId              String
  title               String
  relatedHypothesisId String?
  objective           String?
  method              ExperimentMethod?
  targetAudience      String?
  successCriteria     String?
  expectedEvidence    String?
  status              ExperimentStatus  @default(DRAFT)
  startDate           DateTime?
  endDate             DateTime?
  observations        String[]
  notes               String?
  isDraft             Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  idea       Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  hypothesis Hypothesis?    @relation(fields: [relatedHypothesisId], references: [id])
  evidence   EvidenceItem[]

  @@index([ideaId])
}

model EvidenceItem {
  id                  String        @id @default(uuid())
  ideaId              String
  title               String
  relatedExperimentId String?
  relatedHypothesisId String?
  type                EvidenceType?
  sourceLabel         String?
  date                DateTime?
  observation         String?
  interpretation      String?
  limitations         String?
  isDraft             Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  idea       Idea        @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  experiment Experiment? @relation(fields: [relatedExperimentId], references: [id])
  hypothesis Hypothesis? @relation(fields: [relatedHypothesisId], references: [id])

  @@index([ideaId])
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum Importance {
  HIGH
  MEDIUM
  LOW
}

enum HypothesisCategory {
  PROBLEM
  SOLUTION
  MARKET
  BUSINESS_MODEL
  VALUE_PROPOSITION
  CUSTOMER
  TECHNICAL
}

enum HypothesisStatus {
  DRAFT
  ACTIVE
  TESTING
  VALIDATED
  INVALIDATED
  PAUSED
}

enum ExperimentMethod {
  SURVEY
  INTERVIEW
  LANDING_PAGE
  PROTOTYPE
  AB_TEST
  SMOKE_TEST
  OBSERVATION
}

enum ExperimentStatus {
  DRAFT
  PLANNED
  RUNNING
  COMPLETE
  CANCELLED
}

enum EvidenceType {
  INTERVIEW
  SURVEY
  OBSERVATION
  METRIC
  DOCUMENT
  OTHER
}