generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// Auth
// ─────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions               Session[]
  workspaceMembers       WorkspaceMember[]
  emailVerificationCodes EmailVerificationCode[]
  passwordResetTokens    PasswordResetToken[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────
// Workspace
// ─────────────────────────────────────────

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  products    Product[]
  ideas       Idea[]
  marketIdeas MarketIdea[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────
// Product
// ─────────────────────────────────────────

model Product {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ideas             Idea[]
  mvpProjects       MVPProject[]
  initiatives       Initiative[]
  releases          Release[]
  milestones        Milestone[]
  planningNotes     PlanningNote[]
  launchTasks       LaunchTask[]
  launchAssets      LaunchAsset[]
  channels          Channel[]
  checklistItems    ChecklistItem[]
  feedbackItems     FeedbackItem[]
  themes            Theme[]
  featureRequests   FeatureRequest[]
  productAreas      ProductAreaDefinition[]
  weekSamples       WeekSample[]
  metricDefinitions MetricDefinition[]
  observations      Observation[]
  analyticsReports  AnalyticsReport[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

// ─────────────────────────────────────────
// Stage 01 — Idea Lab
// ─────────────────────────────────────────

model Idea {
  id            String     @id @default(cuid())
  workspaceId   String
  productId     String
  ref           String
  name          String
  headline      String?
  summary       String?
  problem       String?
  audience      String?
  category      String?
  tags          String[]
  status        IdeaStatus @default(INBOX)
  source        String?
  context       String?
  openQuestions String[]
  capturedAt    DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace   Workspace      @relation(fields: [workspaceId], references: [id])
  product     Product        @relation(fields: [productId], references: [id])
  notes       IdeaNote[]
  marketIdea  MarketIdea?
  hypotheses  Hypothesis[]
  experiments Experiment[]
  evidence    EvidenceItem[]
}

model IdeaNote {
  id       String   @id @default(cuid())
  ideaId   String
  author   String
  initials String
  date     DateTime @default(now())
  body     String

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}

enum IdeaStatus {
  INBOX
  EXPLORING
  SHORTLISTED
}

// ─────────────────────────────────────────
// Stage 02 — Market Intelligence
// ─────────────────────────────────────────

model MarketIdea {
  id          String   @id @default(uuid())
  ideaId      String   @unique
  workspaceId String
  summary     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  idea          Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  competitors   Competitor[]
  segments      Segment[]
  opportunities Opportunity[]
  notes         ResearchNote[]

  @@index([workspaceId])
}

model Competitor {
  id             String   @id @default(uuid())
  marketIdeaId   String
  name           String
  website        String?
  description    String?
  strengths      String[]
  weaknesses     String[]
  pricing        String?
  targetAudience String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  marketIdea MarketIdea @relation(fields: [marketIdeaId], references: [id], onDelete: Cascade)

  @@index([marketIdeaId])
}

model Segment {
  id           String   @id @default(uuid())
  marketIdeaId String
  name         String
  description  String
  size         String?
  painPoints   String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  marketIdea    MarketIdea    @relation(fields: [marketIdeaId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([marketIdeaId])
}

model Opportunity {
  id           String   @id @default(uuid())
  marketIdeaId String
  segmentId    String?
  title        String
  description  String
  significance String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  marketIdea MarketIdea @relation(fields: [marketIdeaId], references: [id], onDelete: Cascade)
  segment    Segment?   @relation(fields: [segmentId], references: [id])

  @@index([marketIdeaId])
}

model ResearchNote {
  id           String   @id @default(uuid())
  marketIdeaId String
  relatedType  String
  relatedId    String
  body         String
  author       String?
  createdAt    DateTime @default(now())

  marketIdea MarketIdea @relation(fields: [marketIdeaId], references: [id], onDelete: Cascade)

  @@index([marketIdeaId])
  @@index([relatedType, relatedId])
}

// ─────────────────────────────────────────
// Stage 03 — Validation Lab
// ─────────────────────────────────────────

model Hypothesis {
  id                   String              @id @default(uuid())
  ideaId               String
  title                String
  statement            String
  customerSegment      String?
  category             HypothesisCategory?
  rationale            String?
  importance           Importance          @default(MEDIUM)
  status               HypothesisStatus    @default(DRAFT)
  relatedExperimentIds String[]
  linkedFindings       String[]
  unresolvedQuestions  String[]
  isDraft              Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  idea        Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  experiments Experiment[]
  evidence    EvidenceItem[]

  @@index([ideaId])
}

model Experiment {
  id                  String            @id @default(uuid())
  ideaId              String
  title               String
  relatedHypothesisId String?
  objective           String?
  method              ExperimentMethod?
  targetAudience      String?
  successCriteria     String?
  expectedEvidence    String?
  status              ExperimentStatus  @default(DRAFT)
  startDate           DateTime?
  endDate             DateTime?
  observations        String[]
  notes               String?
  isDraft             Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  idea       Idea           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  hypothesis Hypothesis?    @relation(fields: [relatedHypothesisId], references: [id])
  evidence   EvidenceItem[]

  @@index([ideaId])
}

model EvidenceItem {
  id                  String        @id @default(uuid())
  ideaId              String
  title               String
  relatedExperimentId String?
  relatedHypothesisId String?
  type                EvidenceType?
  sourceLabel         String?
  date                DateTime?
  observation         String?
  interpretation      String?
  limitations         String?
  isDraft             Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  idea       Idea        @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  experiment Experiment? @relation(fields: [relatedExperimentId], references: [id])
  hypothesis Hypothesis? @relation(fields: [relatedHypothesisId], references: [id])

  @@index([ideaId])
}

// ─────────────────────────────────────────
// Stage 04 — MVP Studio
// ─────────────────────────────────────────

model MVPProject {
  id                    String   @id @default(uuid())
  productId             String
  name                  String
  ref                   String?
  status                String   @default("Scoping")
  concept               String?
  problem               String?
  targetAudience        String?
  valueProp             String?
  mvpObjective          String?
  currentScope          String?
  essentialCapabilities String[] @default([])
  explicitExclusions    String[] @default([])
  successCriteria       String[] @default([])
  structure             Json?
  openDecisions         String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product  Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  features Feature[]
  scope    ScopeItem[]

  @@index([productId])
}

model Feature {
  id                 String   @id @default(uuid())
  projectId          String
  name               String
  description        String?
  userProblem        String?
  targetUser         String?
  area               String?
  priority           String   @default("Medium")
  scope              String   @default("Could Have")
  status             String   @default("Proposed")
  userStory          String?
  acceptanceCriteria String[] @default([])
  behavior           String?
  edgeCases          String[] @default([])
  dependencies       String[] @default([])
  openQuestions      String[] @default([])
  designNotes        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project MVPProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ScopeItem {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  explanation String?
  category    String   @default("included")
  status      String   @default("Proposed")
  featureId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project MVPProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ─────────────────────────────────────────
// Stage 05 — Product Roadmap
// ─────────────────────────────────────────

model Initiative {
  id                    String   @id @default(uuid())
  productId             String
  name                  String
  description           String?
  objective             String?
  userProblem           String?
  priority              String   @default("Medium")
  status                String   @default("Proposed")
  period                String   @default("Next")
  relatedFeatures       String[] @default([])
  dependencies          String[] @default([])
  associatedMilestoneId String?
  rationale             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Release {
  id            String    @id @default(uuid())
  productId     String
  name          String
  version       String?
  purpose       String?
  plannedDate   DateTime?
  initiativeIds String[]  @default([])
  status        String    @default("Planned")
  notesPreview  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Milestone {
  id            String    @id @default(uuid())
  productId     String
  name          String
  description   String?
  targetDate    DateTime?
  initiativeIds String[]  @default([])
  status        String    @default("Planned")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model PlanningNote {
  id            String    @id @default(uuid())
  productId     String
  title         String
  summary       String?
  relatedItemId String?
  period        String    @default("Next")
  date          DateTime?
  category      String    @default("Strategic Decision")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─────────────────────────────────────────
// Stage 06 — Launch Center
// ─────────────────────────────────────────

model LaunchTask {
  id               String    @id @default(uuid())
  productId        String
  title            String
  description      String?
  phase            String    @default("Preparation")
  date             DateTime?
  status           String    @default("Not Started")
  owner            String?
  relatedAssetId   String?
  relatedChannelId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model LaunchAsset {
  id               String    @id @default(uuid())
  productId        String
  title            String
  type             String?
  preview          String?
  status           String    @default("Draft")
  lastUpdated      DateTime?
  relatedChannelId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Channel {
  id                String    @id @default(uuid())
  productId         String
  name              String
  campaignObjective String?
  targetAudience    String?
  plannedActivity   String?
  phase             String    @default("Preparation")
  status            String    @default("Not Started")
  relatedAssetIds   String[]  @default([])
  date              DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ChecklistItem {
  id        String   @id @default(uuid())
  productId String
  category  String   @default("General")
  item      String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─────────────────────────────────────────
// Stage 07 — Feedback Hub
// ─────────────────────────────────────────

model FeedbackItem {
  id             String    @id @default(uuid())
  productId      String
  title          String
  excerpt        String?
  description    String?
  category       String    @default("General Feedback")
  source         String?
  date           DateTime?
  priority       String    @default("Medium")
  status         String    @default("New")
  productArea    String?
  internalNotes  String?
  followUpAction String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Theme {
  id                 String   @id @default(uuid())
  productId          String
  name               String
  explanation        String?
  relatedFeedbackIds String[] @default([])
  productArea        String?
  importance         String   @default("Medium")
  reviewStatus       String   @default("New")
  internalNotes      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model FeatureRequest {
  id                  String   @id @default(uuid())
  productId           String
  title               String
  description         String?
  userProblem         String?
  requestedCapability String?
  relatedFeedbackIds  String[] @default([])
  productArea         String?
  priority            String   @default("Medium")
  status              String   @default("New")
  roadmapReference    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductAreaDefinition {
  id          String   @id @default(uuid())
  productId   String
  name        String
  description String?
  summary     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─────────────────────────────────────────
// Stage 08 — Founder Analytics
// ─────────────────────────────────────────

model WeekSample {
  id         String   @id @default(uuid())
  productId  String
  start      DateTime
  active     Int      @default(0)
  newUsers   Int      @default(0)
  sessions   Int      @default(0)
  avgMinutes Float    @default(0)
  perUser    Float    @default(0)
  returnRate Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model MetricDefinition {
  id         String   @id @default(uuid())
  productId  String
  name       String
  definition String?
  category   String   @default("Activity")
  unit       String?
  note       String?
  seriesKey  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Observation {
  id          String   @id @default(uuid())
  productId   String
  title       String
  description String?
  metricId    String?
  type        String   @default("Pattern")
  nextStep    String?
  sample      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model AnalyticsReport {
  id          String    @id @default(uuid())
  productId   String
  title       String
  description String?
  category    String    @default("Growth")
  period      String?
  updated     DateTime?
  paragraphs  String[]  @default([])
  values      Json?
  chart       Json?
  bars        Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum Importance {
  HIGH
  MEDIUM
  LOW
}

enum HypothesisCategory {
  PROBLEM
  SOLUTION
  MARKET
  BUSINESS_MODEL
  VALUE_PROPOSITION
  CUSTOMER
  TECHNICAL
}

enum HypothesisStatus {
  DRAFT
  ACTIVE
  TESTING
  VALIDATED
  INVALIDATED
  PAUSED
}

enum ExperimentMethod {
  SURVEY
  INTERVIEW
  LANDING_PAGE
  PROTOTYPE
  AB_TEST
  SMOKE_TEST
  OBSERVATION
}

enum ExperimentStatus {
  DRAFT
  PLANNED
  RUNNING
  COMPLETE
  CANCELLED
}

enum EvidenceType {
  INTERVIEW
  SURVEY
  OBSERVATION
  METRIC
  DOCUMENT
  OTHER
}
